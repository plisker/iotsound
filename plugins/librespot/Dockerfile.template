# ----------------------
# Stage 1: Build go-librespot
# ----------------------
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache \
    git \
    build-base \
    pkgconf \
    alsa-lib-dev \
    libogg-dev \
    libvorbis-dev \
    flac-dev

# Pinned to a commit on plisker/go-librespot @ deploy-clean (not a branch name):
# reproducible builds, and bumping the SHA busts balena's git-clone layer cache so a
# new fork commit is actually picked up. Bump this on each fork change.
# deploy-clean = devgianlu/master + pulseaudio start-clip fix (#292) + context-metadata
# & set_queue "Next from:" fixes (#329). No DJ fork; DJ mode is not supported on this base.
RUN git clone https://github.com/plisker/go-librespot.git /go-librespot \
    && git -C /go-librespot checkout 3f5eb78c019b17fceeb10a4a7871f24115bc6b9b
WORKDIR /go-librespot
RUN go mod download
RUN go build -v -o /daemon ./cmd/daemon

# ----------------------
# Stage 2: Runtime image
# ----------------------
FROM alpine:3.23

RUN apk add --no-cache \
    bash \
    ca-certificates \
    avahi \
    libgcc \
    gcompat \
    alsa-lib \
    libogg \
    libvorbis \
    flac

ENV PULSE_SERVER=tcp:localhost:4317

COPY --from=builder /daemon /usr/src/daemon
COPY start.sh /usr/src/

WORKDIR /usr/src/
CMD ["/bin/bash", "/usr/src/start.sh"]
